---
// Decap CMS. Served as a page (not from public/) so /admin/ also works on the dev server.
// Its config lives in public/admin/config.yml.
import previewStyles from '@/styles/cms-preview.css?url';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Snesie& · Beheer</title>
  </head>
  <body data-preview-styles={previewStyles}>
    <!-- Decap CMS: edits the JSON files in src/content via git. See README "Content beheren". -->
    <script is:inline src="https://unpkg.com/decap-cms@3.16.3/dist/decap-cms.js"></script>
    <script>
      import { registerPreviews } from '@/scripts/cms-preview';

      // Module scripts run after the classic Decap script above, so CMS and h exist.
      if (window.CMS && window.h) registerPreviews(window.CMS, window.h, document.body.dataset.previewStyles!);
    </script>
  </body>
</html>
