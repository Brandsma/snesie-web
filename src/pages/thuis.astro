---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Soundboard from '@/components/thuis/Soundboard.astro';
import { img } from '@/lib/images';
import hakkaA from '@/assets/fonts/hakka-a.woff2?url';
import hakkaB from '@/assets/fonts/hakka-b.woff2?url';
import hakkaC from '@/assets/fonts/hakka-c.woff2?url';

const ATTIC = [
  'Een oude koffer op zolder',
  'Een vergeelde brief',
  'Een foto zonder naam',
  'Een tante die nog weet waarom opa nooit over China sprak',
  'Een oom die de naam van het dorp kent waar de familie vandaan kwam',
];

const STEPS = [
  'Vraag je ouders, grootouders, ooms en tantes naar hun herinneringen.',
  "Digitaliseer oude foto's.",
  'Schrijf verhalen op.',
  'Neem gesprekken op.',
  'Bewaar namen, plaatsen en familietradities.',
];

const TURN = ['Om te luisteren.', 'Om vragen te stellen.', 'Om de stilte te doorbreken.'];

// Subset of Noto Serif SC containing only 客家山歌 (~3 KB in total).
const face = (url: string, range: string) =>
  `@font-face{font-family:'Snesie Hakka';font-style:normal;font-weight:400;font-display:swap;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fontCss = [face(hakkaA, 'U+6B4C'), face(hakkaB, 'U+5C71'), face(hakkaC, 'U+5BA2,U+5BB6')].join('');
---

<BaseLayout
  title="Thuis, ons verleden, ons heden"
  description="Iedere familie heeft herinneringen die nergens anders bestaan. Ontdek, bewaar en deel de verhalen, foto's en liederen van thuis."
  current="thuis"
  ogImage="herinnering-2.jpg"
>
  <style is:inline slot="head" set:html={fontCss} />

  <section class="hero">
    <div class="hero-inner container">
      <div>
        <div class="hero-labels label label--small">
          <span>Thuis</span><a href="#muziek">Muziek ↓</a>
        </div>
        <h1 class="hero-title">Thuis,<br /><em>ons verleden,</em><br />ons heden</h1>
        <p class="hero-intro">Iedere familie heeft herinneringen die nergens anders bestaan.</p>
      </div>
      <div class="collage" data-collage>
        <Image
          src={img('chan-hua-flower.png')}
          alt=""
          widths={[360, 720]}
          sizes="(min-width: 980px) 340px, 58vw"
          class="collage-flower"
          data-parallax="flower"
          loading="eager"
        />
        <figure class="collage-a" data-parallax="a">
          <Image
            src={img('herinnering.jpg')}
            alt="Tastbare herinneringen"
            widths={[360, 700]}
            sizes="(min-width: 980px) 330px, 52vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <figure class="collage-b" data-parallax="b">
          <Image
            src={img('herinnering-2.jpg')}
            alt="Tastbare herinneringen"
            widths={[320, 640, 900]}
            sizes="(min-width: 980px) 280px, 44vw"
            loading="eager"
          />
          <figcaption>Tastbare herinneringen</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="attic">
    <div class="container section two-col">
      <div data-reveal>
        <div class="label">Verhalen verdienen het om verteld te worden</div>
        <p class="attic-quote">
          Niet omdat we in het verleden willen blijven leven, maar omdat het verleden ons helpt te begrijpen wie we vandaag
          zijn.
        </p>
        <p class="body-lg attic-body">
          Dat zijn geen kleine herinneringen. Dat zijn stukjes geschiedenis. En als wij ze niet vastleggen, verdwijnen ze
          misschien voorgoed.
        </p>
        <div class="counter" aria-live="polite">
          <span class="counter-num" data-attic-count>0</span>
          <span class="counter-label" data-attic-label>stukjes geschiedenis bij jou thuis</span>
        </div>
        <a href="/#join" class="btn btn--primary attic-cta" hidden data-attic-cta>Leg ze vast met Snesie&amp; →</a>
      </div>
      <div>
        <div class="attic-hint" data-reveal>Wat ligt er bij jou thuis? Tik aan wat je herkent.</div>
        {
          ATTIC.map((t, i) => (
            <button type="button" class="attic-row" aria-pressed="false" data-reveal data-delay={i * 90} data-attic-item>
              <span class="tick" aria-hidden="true" />
              <span class="attic-text">{t}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="steps-head" data-reveal>
      <div class="label">Jong en oud</div>
      <h2 class="steps-title">Daarom nodigt Snesie&amp; iedereen uit om op onderzoek uit te gaan.</h2>
    </div>
    <ol class="steps">
      {
        STEPS.map((t, i) => (
          <li data-reveal data-delay={i * 100}>
            <span class="step-n">0{i + 1}</span>
            <span class="step-t">{t}</span>
          </li>
        ))
      }
    </ol>
    <p class="body-lg steps-outro" data-reveal>
      Niet alleen voor jezelf, maar ook voor de generaties die na ons komen. Want trots begint met weten waar je vandaan
      komt. Onze geschiedenis is niet alleen het verhaal van contractarbeid of migratie. Het is ook het verhaal van
      veerkracht, ondernemerschap, familiebanden, cultuur en identiteit.
    </p>
  </section>

  <section class="turn">
    <div class="container turn-inner">
      <div class="label turn-label">Nu is het onze beurt</div>
      <div class="turn-lines">
        {TURN.map((t) => <span>{t}</span>)}
      </div>
      <p class="turn-ask">‘Vertel eens... hoe begon ons verhaal?’</p>
    </div>
  </section>

  <section id="muziek" class="music">
    <div class="container music-inner two-col">
      <div data-reveal>
        <div class="label">Muziek</div>
        <div class="cjk" lang="zh-Hans">客家山歌</div>
        <h2 class="music-title">Hakka Mountain Songs <span>· Shan Ge</span></h2>
        <p class="music-lead">Sommige verhalen worden geschreven en andere worden gezongen.</p>
      </div>
      <div class="prose" data-reveal data-delay="120">
        <p>
          Wanneer mensen hun thuisland verlaten, nemen ze niet alles mee. Huizen blijven achter. Landschappen veranderen.
          Generaties gaan voorbij. Maar sommige dingen reizen altijd mee. Een lied. Een melodie. Een herinnering.
        </p>
        <p>
          De Hakka Mountain Songs behoren tot het oudste culturele erfgoed van de Hakka-gemeenschap. Generaties lang werden
          deze liederen gezongen tijdens het werken op het land, onderweg door de bergen of tijdens ontmoetingen met familie
          en vrienden. Ze vertellen over liefde, heimwee, afscheid, hoop en het dagelijks leven.
        </p>
        <p>Zo wordt een melodie een verhaal. En een verhaal een brug tussen verleden en toekomst.</p>
      </div>
    </div>
  </section>

  <Soundboard />

  <section class="container section">
    <div class="two-col">
      <div data-reveal>
        <div class="label">Een gezongen familieverhaal</div>
        <p class="sung-lead">
          Luister, ontdek en beleef. Misschien hoor je een prachtig lied, de stem van je overgrootmoeder of voor het eerst
          een stukje van jezelf.
        </p>
      </div>
      <div class="prose" data-reveal data-delay="120">
        <p>
          Bij Snesie&amp; geloven we dat erfgoed niet alleen zichtbaar is in foto’s of documenten. Het leeft ook in geluid.
          In stemmen. In rituelen. In recepten. En in liederen die van generatie op generatie zijn doorgegeven.
        </p>
        <p>
          Wanneer je naar deze liederen luistert, hoor je misschien woorden die je niet verstaat. Toch herken je vaak de
          emotie. Verlangen. Trots. Gemis. Verbondenheid.
        </p>
        <h3 class="prose-h3">Van de bergen naar Suriname, van Suriname naar Nederland</h3>
        <p>
          De reis van onze voorouders eindigde niet toen zij aankwamen in Suriname. Hun taal, muziek en tradities reisden
          met hen mee. Ze veranderden, kregen nieuwe invloeden en werden onderdeel van een nieuwe identiteit. Vandaag mogen
          wij die geschiedenis opnieuw ontdekken, bewaren en doorgeven.
        </p>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-inner">
      <Image src={img('chan-hua-flower.png')} alt="" width={72} densities={[1, 2]} class="closing-flower" data-reveal />
      <h2 class="closing-quote" data-reveal>
        Niet uit nostalgie, maar omdat je de toekomst beter begrijpt wanneer je weet waar je vandaan komt.
      </h2>
      <p class="closing-text" data-reveal>Elke familie draagt een verhaal; samen vertellen we onze geschiedenis.</p>
      <a href="/#join" class="text-cta closing-cta" data-reveal>Deel je verhaal →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    padding-top: clamp(120px, 17vh, 180px);
    padding-bottom: clamp(64px, 10vh, 120px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: var(--col-gap);
    align-items: end;
  }

  .hero-labels {
    display: flex;
    gap: 18px;
  }

  .hero-labels a {
    color: var(--muted);
    text-decoration: none;
  }

  .hero-labels a:hover {
    color: var(--blue);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 8vw, 124px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin-top: 24px;
  }

  .hero-title em {
    color: var(--blue);
  }

  .hero-intro {
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.55;
    max-width: 28em;
    margin: 36px 0 0;
    color: var(--body-soft);
  }

  .collage {
    position: relative;
    min-height: clamp(380px, 52vw, 620px);
  }

  .collage-flower,
  .collage-a,
  .collage-b {
    position: absolute;
    transition: transform 0.9s var(--ease-out);
  }

  .collage-flower {
    z-index: 2;
    mix-blend-mode: multiply;
    pointer-events: none;
    width: 58%;
    height: auto;
    right: -6%;
    bottom: -4%;
  }

  .collage figure {
    margin: 0;
  }

  .collage-a {
    left: 0;
    top: 0;
    width: 52%;
    transform: rotate(-2deg);
  }

  .collage-b {
    right: 4%;
    top: 14%;
    width: 44%;
    transform: rotate(1.5deg);
  }

  .collage-a :global(img),
  .collage-b :global(img) {
    width: 100%;
    object-fit: cover;
    border-radius: 2px;
  }

  .collage-a :global(img) {
    aspect-ratio: 2 / 3;
  }

  .collage-b :global(img) {
    aspect-ratio: 3 / 2;
  }

  .collage-b figcaption {
    font-size: 13px;
    color: var(--muted);
    margin-top: 10px;
  }

  /* Attic */
  .attic {
    background: var(--sand);
  }

  .attic-quote {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.18;
    letter-spacing: -0.015em;
    margin: 24px 0 0;
  }

  .attic-body {
    margin: 28px 0 0;
  }

  .counter {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--sand-line-strong);
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .counter-num {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }

  .counter-label {
    font-size: 16px;
    line-height: 1.45;
    color: var(--body-soft);
    max-width: 18em;
  }

  .attic-cta {
    margin-top: 20px;
  }

  .attic-hint {
    font-size: 13px;
    color: var(--muted);
    padding-bottom: 14px;
  }

  .attic-row {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-top: 1px solid var(--sand-line-strong);
    padding: 22px 0;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: center;
    color: var(--ink);
  }

  .tick {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    border: 1.5px solid var(--unknown);
    color: #fff;
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }

  .attic-text {
    font-family: var(--font-serif);
    font-size: clamp(21px, 1.9vw, 27px);
    line-height: 1.3;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .attic-row[aria-pressed='true'] .tick {
    background: var(--blue);
    border-color: var(--blue);
  }

  .attic-row[aria-pressed='true'] .tick::before {
    content: '✓';
  }

  .attic-row[aria-pressed='true'] .attic-text {
    text-decoration-line: underline;
  }

  /* Steps */
  .steps-head {
    max-width: 820px;
  }

  .steps-title {
    font-family: var(--font-serif);
    font-size: clamp(34px, 4.4vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.022em;
    margin-top: 20px;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: clamp(40px, 6vh, 72px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border-top: 1px solid var(--ink);
  }

  .steps li {
    padding: 28px 24px 28px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .step-n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    color: var(--blue);
  }

  .step-t {
    font-size: 18px;
    line-height: 1.45;
    font-weight: 500;
    text-wrap: pretty;
  }

  .steps-outro {
    margin: 40px 0 0;
    max-width: 40em;
  }

  /* Nu is het onze beurt */
  .turn {
    background: var(--ink);
    color: var(--paper);
  }

  .turn-inner {
    padding-block: clamp(88px, 14vh, 160px);
  }

  .turn-label {
    color: var(--blue-light);
  }

  .turn-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 28px;
  }

  .turn-lines span {
    font-family: var(--font-serif);
    font-size: clamp(34px, 5.4vw, 80px);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .turn-ask {
    margin: clamp(32px, 6vh, 56px) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.2;
    color: var(--blue-light);
  }

  /* Muziek */
  .music {
    scroll-margin-top: 72px;
  }

  .music-inner {
    padding-top: var(--section-y);
    padding-bottom: clamp(56px, 8vh, 96px);
    align-items: start;
  }

  .cjk {
    font-family: var(--font-cjk);
    font-size: clamp(56px, 7vw, 104px);
    line-height: 1;
    margin-top: 24px;
    color: var(--blue);
    letter-spacing: 0.04em;
  }

  .music-title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 3.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-top: 18px;
  }

  .music-title span {
    color: var(--muted);
  }

  .music-lead {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.3;
    margin: 32px 0 0;
    max-width: 22em;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body-soft);
  }

  .prose p {
    margin: 0;
  }

  .prose-h3 {
    margin-top: 24px;
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.15;
    color: var(--ink);
  }

  .sung-lead {
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1.2;
    margin: 24px 0 0;
  }

  /* Closing */
  .closing {
    background: var(--sand);
  }

  .closing-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(96px, 15vh, 180px) var(--gutter);
    text-align: center;
  }

  .closing-flower {
    width: 72px;
    height: auto;
    margin: 0 auto 36px;
  }

  .closing-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(30px, 4.2vw, 60px);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .closing-text {
    margin: 36px 0 0;
    font-size: 18px;
    color: var(--body-soft);
  }

  .closing-cta {
    display: inline-block;
    margin-top: 32px;
  }
</style>

<script>
  import { onScroll } from '@/scripts/scroll';
  import { prefersReducedMotion } from '@/scripts/motion';

  // "Wat ligt er bij jou thuis?" counter.
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-attic-item]')];
  const count = document.querySelector<HTMLElement>('[data-attic-count]')!;
  const label = document.querySelector<HTMLElement>('[data-attic-label]')!;
  const cta = document.querySelector<HTMLElement>('[data-attic-cta]')!;

  const update = () => {
    const n = items.filter((b) => b.getAttribute('aria-pressed') === 'true').length;
    count.textContent = String(n);
    label.textContent = n === 1 ? 'stukje geschiedenis bij jou thuis' : 'stukjes geschiedenis bij jou thuis';
    cta.hidden = n === 0;
  };

  items.forEach((b) =>
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      update();
    }),
  );

  // Light parallax on the hero collage.
  if (!prefersReducedMotion()) {
    const get = (k: string) => document.querySelector<HTMLElement>(`[data-parallax="${k}"]`)!;
    const flower = get('flower');
    const a = get('a');
    const b = get('b');
    const limit = window.innerHeight * 1.5;
    onScroll((y) => {
      if (y > limit) return;
      flower.style.transform = `translateY(${(y * -0.08).toFixed(1)}px) rotate(${(y * 0.04).toFixed(2)}deg)`;
      a.style.transform = `translateY(${(y * 0.06).toFixed(1)}px) rotate(-2deg)`;
      b.style.transform = `translateY(${(y * -0.04).toFixed(1)}px) rotate(1.5deg)`;
    });
  }
</script>
