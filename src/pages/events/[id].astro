---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEvents, hasDetailPage, icsHref, mapsHref, type EventData } from '@/lib/events';
import { countdownLabel, formatLong, parseLocal, MONTHS_SHORT } from '@/lib/dates';
import { isUpcoming } from '@/lib/event-schedule';
import { img } from '@/lib/images';

export const getStaticPaths = (async () => {
  const events = await getEvents();
  return events.filter(hasDetailPage).map((event) => ({
    params: { id: event.id },
    props: {
      event,
      siblings: event.series ? events.filter((x) => x.series === event.series && x.id !== event.id && hasDetailPage(x)) : [],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  event: EventData;
  siblings: EventData[];
}

const { event: ev, siblings } = Astro.props;

// Build-date rendering; src/scripts/events-live.ts updates countdown and
// past/upcoming state with the visitor's date.
const now = new Date();
const d = parseLocal(ev.start);
const past = !isUpcoming(ev.start, now);
const month = d.toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' });
const when = formatLong(d) + (ev.time ? `, ${ev.time}` : '');
---

<BaseLayout title={ev.title} description={ev.sub ?? ev.summary} current="events" ogImage={ev.image}>
  <div data-event-detail data-start={ev.start}>
    <section class="container head">
      <nav class="crumbs" aria-label="Kruimelpad">
        <a href="/events/">← Events</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="crumb-type">{ev.type} · {ev.city}</span>
        <span class="crumb-past" data-past-only hidden={!past}>Geweest</span>
      </nav>
      <h1>{ev.title}</h1>
      {ev.sub && <p class="sub">{ev.sub}</p>}
    </section>

    <section class="container layout">
      <div class="content">
        <Image
          src={img(ev.image)}
          alt={ev.venue}
          widths={[480, 760, 1100, 1520]}
          sizes="(min-width: 1320px) 760px, (min-width: 980px) calc(100vw - 560px), 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
        <div class="body">
          {
            ev.body?.map((b) =>
              b.t === 'lead' ? (
                <p class="lead">{b.text}</p>
              ) : b.t === 'p' ? (
                <p class="p">{b.text}</p>
              ) : (
                <div class="speaker">
                  <span class="avatar" aria-hidden="true">
                    {b.name.charAt(0)}
                  </span>
                  <div class="speaker-text">
                    <span class="label label--small label--muted">Spreker</span>
                    <span class="speaker-name">{b.name}</span>
                    <span class="speaker-bio">{b.text}</span>
                  </div>
                </div>
              ),
            )
          }
        </div>
      </div>

      <aside class="aside">
        <div class="panel">
          <div class="date">
            <span class="day">{d.getDate()}</span>
            <span class="date-meta">
              <span class="month">{month}</span>
              <span data-countdown>{countdownLabel(d, now)}</span>
            </span>
          </div>
          <dl class="facts">
            <dt>Wanneer</dt>
            <dd>{when}</dd>
            <dt>Waar</dt>
            <dd>{ev.where}</dd>
            <dt>Deelname</dt>
            <dd>{ev.price}</dd>
          </dl>
          <div class="actions" data-upcoming-only hidden={past}>
            {
              ev.signup && (
                <a href={ev.signup} target="_blank" rel="noopener noreferrer" class="btn btn--light">
                  Aanmelden ↗
                </a>
              )
            }
            <div class="actions-row">
              <a href={icsHref(ev)} download class="btn btn--outline-light">
                Zet in agenda
              </a>
              <a href={mapsHref(ev)} target="_blank" rel="noopener noreferrer" class="btn btn--outline-light">
                Route ↗
              </a>
            </div>
          </div>
          <a href="/wij/#in-beeld" class="btn btn--outline-light" data-past-only hidden={!past}>
            Bekijk de foto's in beeld
          </a>
        </div>

        {
          siblings.length > 0 && (
            <div class="siblings">
              <p class="siblings-note">
                Het programma is op alle drie bijeenkomsten gelijk; bij aanmelding kies je één datum.
              </p>
              {siblings.map((s) => {
                const sd = parseLocal(s.start);
                return (
                  <a href={`/events/${s.id}/`} class="sibling">
                    <span class="sibling-day">
                      {sd.getDate()}
                      <span class="sibling-month">{MONTHS_SHORT[sd.getMonth()]}</span>
                    </span>
                    <span class="sibling-city">
                      {s.city}
                      <span class="sibling-venue">{s.venue}</span>
                    </span>
                    <span aria-hidden="true">→</span>
                  </a>
                );
              })}
            </div>
          )
        }
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(112px, 15vh, 160px);
  }

  .crumbs {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--blue);
  }

  .sep {
    color: var(--tree-line);
  }

  .crumb-type {
    color: var(--blue);
  }

  .crumb-past {
    color: var(--terracotta);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, 92px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 24px;
    max-width: 15em;
  }

  .sub {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.25;
    color: var(--blue);
    max-width: 28em;
  }

  .layout {
    padding-top: clamp(40px, 6vh, 64px);
    padding-bottom: clamp(72px, 11vh, 120px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  .content :global(.hero-img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
    background: var(--sand);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 680px;
  }

  .lead {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2vw, 27px);
    line-height: 1.4;
  }

  .p {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--body-soft-2);
  }

  .speaker {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    align-items: start;
    padding: 24px;
    background: var(--sand);
    border-radius: 4px;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 24px;
  }

  .speaker-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .speaker-name {
    font-family: var(--font-serif);
    font-size: 24px;
  }

  .speaker-bio {
    font-size: 16px;
    line-height: 1.6;
    color: var(--body-soft);
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .panel {
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
    padding: clamp(24px, 2.6vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .date {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .day {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .date-meta {
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 1.3;
    color: var(--on-ink-soft);
  }

  .month {
    text-transform: capitalize;
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 18px;
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    padding-top: 18px;
    border-top: 1px solid rgba(245, 240, 231, 0.2);
  }

  .facts dt {
    color: var(--blue-light);
  }

  .facts dd {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .actions-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .actions-row .btn {
    min-height: 48px;
    padding: 0 12px;
    font-size: 14px;
  }

  .siblings {
    background: var(--sand);
    border-radius: 4px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .siblings-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--body-soft);
    padding-bottom: 10px;
  }

  .sibling {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 0;
    border-top: 1px solid var(--sand-line-strong);
    text-decoration: none;
    color: var(--ink);
  }

  .sibling:hover {
    color: var(--blue);
  }

  .sibling-day {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1;
  }

  .sibling-month {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }

  .sibling-city {
    font-size: 15px;
    font-weight: 600;
  }

  .sibling-venue {
    display: block;
    font-weight: 400;
    font-size: 13px;
    color: var(--muted);
  }

  @media (min-width: 980px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 380px;
    }

    .aside {
      position: sticky;
      top: 110px;
    }
  }
</style>

<script>
  import { initEventDetail } from '@/scripts/events-live';

  initEventDetail();
</script>
