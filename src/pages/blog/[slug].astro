---
import { Image, getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Lightbox from '@/components/Lightbox.astro';
import { img } from '@/lib/images';
import { getPosts, formatPostDate, postHref, type Post } from '@/components/blog/posts';
import { SITE } from '@/lib/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Prev/next wrap around, like the design.
      prev: posts[(i - 1 + posts.length) % posts.length],
      next: posts[(i + 1) % posts.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  prev: Post;
  next: Post;
}

const { post, prev, next } = Astro.props;
const { data } = post;
const date = formatPostDate(data.date);
const shareUrl = new URL(postHref(post), Astro.site ?? SITE.url).href;
const lead = data.blocks.find((b) => b.t === 'lead');

// Full-size versions for the lightbox, built once per gallery image.
const galleries = await Promise.all(
  data.blocks.map(async (b) =>
    b.t === 'gallery'
      ? Promise.all(
          b.images.map(async (name) => {
            const src = img(name);
            const full = await getImage({ src, width: Math.min(1800, src.width), format: 'webp' });
            return { name, src, full: full.src };
          }),
        )
      : null,
  ),
);
---

<BaseLayout
  title={data.title}
  description={lead && 'text' in lead ? lead.text : undefined}
  current="media"
  ogImage={data.hero}
>
  <article>
    <header class="head container">
      <nav class="crumbs" aria-label="Kruimelpad">
        <a href="/media/">Media</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="here">{data.tag}</span>
      </nav>
      <h1>{data.title}</h1>
      <div class="metabar">
        <span class="author">
          <span class="avatar" aria-hidden="true">{data.author.charAt(0)}</span>
          <span class="author-name">{data.author}</span>
        </span>
        {date && <span class="muted">{date}</span>}
        <span class="muted">{data.read}</span>
        <button type="button" class="share" data-share={shareUrl} aria-live="polite">Deel dit bericht</button>
      </div>
    </header>

    <figure class="hero container">
      <div class="hero-frame">
        <Image
          src={img(data.hero)}
          alt={data.title}
          widths={[640, 960, 1320, 1800]}
          sizes="(min-width: 1320px) 1224px, calc(100vw - 2 * clamp(20px, 4vw, 48px))"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {data.caption && <figcaption>{data.caption}</figcaption>}
    </figure>

    <div class="body">
      {
        data.blocks.map((b, i) => {
          switch (b.t) {
            case 'lead':
              return <p class="lead">{b.text}</p>;
            case 'p':
              return <p class="p">{b.text}</p>;
            case 'credit':
              return <p class="credit">{b.text}</p>;
            case 'link': {
              const external = /^https?:/.test(b.href);
              return (
                <a
                  href={b.href}
                  class="link-card"
                  {...(external || b.href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="link-text">
                    <span class="link-label">{b.label}</span>
                    <span class="link-title">{b.text}</span>
                  </span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              );
            }
            case 'gallery':
              return (
                <div class="gallery">
                  {galleries[i]!.map((g, n) => (
                    <a href={g.full} data-lightbox="post" class="g-item" aria-label={`Foto ${n + 1} vergroten`}>
                      <Image
                        src={g.src}
                        alt={`Foto ${n + 1}`}
                        width={720}
                        height={480}
                        fit="cover"
                        widths={[360, 720]}
                        sizes="(min-width: 1320px) 400px, (min-width: 640px) 33vw, 100vw"
                      />
                    </a>
                  ))}
                </div>
              );
          }
        })
      }
    </div>

    <nav class="pager" aria-label="Meer berichten">
      <div class="pager-inner container">
        <a href={postHref(prev)} class="pager-link" rel="prev">
          <span class="pager-label">← Vorige</span>
          <span class="pager-title">{prev.data.title}</span>
        </a>
        <a href={postHref(next)} class="pager-link pager-next" rel="next">
          <span class="pager-label">Volgende →</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      </div>
    </nav>
  </article>

  <Lightbox />
</BaseLayout>

<style>
  .head {
    padding-top: clamp(112px, 15vh, 160px);
  }

  .crumbs {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--blue);
  }

  .sep {
    color: var(--tree-line);
  }

  .here {
    color: var(--blue);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.028em;
    margin-top: 24px;
    max-width: 16em;
  }

  .metabar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 32px;
    padding: 18px 0;
    border-top: 1px solid var(--sand-line-strong);
    border-bottom: 1px solid var(--sand-line-strong);
    font-size: 15px;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 18px;
  }

  .author-name {
    font-weight: 600;
  }

  .muted {
    color: var(--muted);
  }

  .share {
    white-space: nowrap;
    flex: none;
    margin-left: auto;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .share[data-copied] {
    background: var(--ink);
    color: var(--paper);
  }

  .hero {
    margin: clamp(32px, 5vh, 56px) auto 0;
  }

  /* Never crop the hero: contain it in a sand frame. */
  .hero-frame {
    width: 100%;
    height: min(72vh, 760px);
    border-radius: 4px;
    background: var(--sand);
    overflow: hidden;
  }

  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  figcaption {
    font-size: 13px;
    color: var(--muted);
    margin-top: 12px;
  }

  .body {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 8vh, 88px) var(--gutter) clamp(64px, 10vh, 112px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .body p {
    margin: 0;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: clamp(23px, 2vw, 28px);
    line-height: 1.38;
    letter-spacing: -0.008em;
  }

  .p {
    font-size: 19px;
    line-height: 1.7;
    color: var(--body-soft-2);
  }

  .credit {
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
  }

  .link-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
    background: var(--white);
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink);
  }

  .link-card:hover {
    color: var(--blue);
  }

  .link-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .link-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }

  .link-title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .link-arrow {
    flex: none;
    font-size: 20px;
  }

  /* The gallery breaks out of the 760px text column on wide screens. */
  .gallery {
    margin: 16px calc(-1 * clamp(0px, (100vw - 760px) / 2, 280px)) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 10px;
  }

  .g-item {
    display: block;
    cursor: zoom-in;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--sand);
  }

  .g-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .g-item:hover :global(img),
  .g-item:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .pager {
    background: var(--sand);
  }

  .pager-inner {
    padding-block: clamp(56px, 9vh, 96px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 16px;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: 4px;
    background: var(--paper);
    text-decoration: none;
    color: var(--ink);
  }

  .pager-link:hover {
    color: var(--blue);
  }

  .pager-next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }

  .pager-title {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.2;
    text-wrap: pretty;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share]');

  async function copy(text: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for browsers without the async clipboard API (or without permission).
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      document.execCommand('copy');
      field.remove();
    }
  }

  if (button) {
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      await copy(button.dataset.share!);
      button.textContent = 'Link gekopieerd ✓';
      button.setAttribute('data-copied', '');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = 'Deel dit bericht';
        button.removeAttribute('data-copied');
      }, 1800);
    });
  }
</script>
