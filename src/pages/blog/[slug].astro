---
import { Image, getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/blog-post.css';
import Lightbox from '@/components/Lightbox.astro';
import { img } from '@/lib/images';
import { getPosts, formatPostDate, postHref, type Post } from '@/components/blog/posts';
import { SITE } from '@/lib/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Prev/next wrap around, like the design.
      prev: posts[(i - 1 + posts.length) % posts.length],
      next: posts[(i + 1) % posts.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  prev: Post;
  next: Post;
}

const { post, prev, next } = Astro.props;
const { data } = post;
const date = formatPostDate(data.date);
const shareUrl = new URL(postHref(post), Astro.site ?? SITE.url).href;
const lead = data.blocks.find((b) => b.t === 'lead');

// Full-size versions for the lightbox, built once per gallery image.
const galleries = await Promise.all(
  data.blocks.map(async (b) =>
    b.t === 'gallery'
      ? Promise.all(
          b.images.map(async (name) => {
            const src = img(name);
            const full = await getImage({ src, width: Math.min(1800, src.width), format: 'webp' });
            return { name, src, full: full.src };
          }),
        )
      : null,
  ),
);
---

<BaseLayout
  title={data.title}
  description={lead && 'text' in lead ? lead.text : undefined}
  current="media"
  ogImage={data.hero}
>
  <article class="post-page">
    <header class="head container">
      <nav class="crumbs" aria-label="Kruimelpad">
        <a href="/media/">Media</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="here">{data.tag}</span>
      </nav>
      <h1>{data.title}</h1>
      <div class="metabar">
        <span class="author">
          <span class="avatar" aria-hidden="true">{data.author.charAt(0)}</span>
          <span class="author-name">{data.author}</span>
        </span>
        {date && <span class="muted">{date}</span>}
        <span class="muted">{data.read}</span>
        <button type="button" class="share" data-share={shareUrl} aria-live="polite">Deel dit bericht</button>
      </div>
    </header>

    <figure class="hero container">
      <div class="hero-frame">
        <Image
          src={img(data.hero)}
          alt={data.title}
          widths={[640, 960, 1320, 1800]}
          sizes="(min-width: 1320px) 1224px, calc(100vw - 2 * clamp(20px, 4vw, 48px))"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {data.caption && <figcaption>{data.caption}</figcaption>}
    </figure>

    <div class="body">
      {
        data.blocks.map((b, i) => {
          switch (b.t) {
            case 'lead':
              return <p class="lead">{b.text}</p>;
            case 'p':
              return <p class="p">{b.text}</p>;
            case 'credit':
              return <p class="credit">{b.text}</p>;
            case 'link': {
              const external = /^https?:/.test(b.href);
              return (
                <a
                  href={b.href}
                  class="link-card"
                  {...(external || b.href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="link-text">
                    <span class="link-label">{b.label}</span>
                    <span class="link-title">{b.text}</span>
                  </span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              );
            }
            case 'gallery':
              return (
                <div class="gallery">
                  {galleries[i]!.map((g, n) => (
                    <a href={g.full} data-lightbox="post" class="g-item" aria-label={`Foto ${n + 1} vergroten`}>
                      <Image
                        src={g.src}
                        alt={`Foto ${n + 1}`}
                        width={720}
                        height={480}
                        fit="cover"
                        widths={[360, 720]}
                        sizes="(min-width: 1320px) 400px, (min-width: 640px) 33vw, 100vw"
                      />
                    </a>
                  ))}
                </div>
              );
          }
        })
      }
    </div>

    <nav class="pager" aria-label="Meer berichten">
      <div class="pager-inner container">
        <a href={postHref(prev)} class="pager-link" rel="prev">
          <span class="pager-label">← Vorige</span>
          <span class="pager-title">{prev.data.title}</span>
        </a>
        <a href={postHref(next)} class="pager-link pager-next" rel="next">
          <span class="pager-label">Volgende →</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      </div>
    </nav>
  </article>

  <Lightbox />
</BaseLayout>


<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share]');

  async function copy(text: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for browsers without the async clipboard API (or without permission).
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      document.execCommand('copy');
      field.remove();
    }
  }

  if (button) {
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      await copy(button.dataset.share!);
      button.textContent = 'Link gekopieerd ✓';
      button.setAttribute('data-copied', '');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = 'Deel dit bericht';
        button.removeAttribute('data-copied');
      }, 1800);
    });
  }
</script>
