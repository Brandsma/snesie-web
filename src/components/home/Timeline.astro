---
import { TIMELINE } from '@/data/timeline';
---

<!--
  Pinned horizontal timeline. With JavaScript (and motion allowed) the section
  is 560vh tall and vertical scrolling moves the card track sideways. Without
  JavaScript or with reduced motion it falls back to a plain horizontally
  scrollable row of cards.
-->
<section id="tocht" class="tocht" data-timeline>
  <div class="pin">
    <div class="head container">
      <div class="intro">
        <div class="label tl-label">De tocht · Migratie &amp; koloniaal beleid</div>
        <h2>Meer dan 170 jaar geleden maakten duizenden Chinezen de oversteek naar Suriname.</h2>
      </div>
      <div class="year" aria-hidden="true" data-year>{TIMELINE[0].year}</div>
    </div>

    <div class="track-wrap" data-track-wrap>
      <ol class="track" data-track>
        {
          TIMELINE.map((c, i) => (
            <li class:list={['card', { 'is-active': i === 0 }]} data-card>
              <div class="place">{c.place}</div>
              <div class="card-year">{c.year}</div>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="controls container" data-controls hidden>
      <div
        class="slider"
        tabindex="0"
        role="slider"
        aria-label="Tijdlijn, gebruik de pijltjestoetsen"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext={TIMELINE[0].year}
        data-slider
      >
        <div class="rail">
          <div class="fill" data-fill></div>
          <div class="knob" data-knob></div>
        </div>
      </div>
      <div class="hint" data-hint>Sleep om door de tijdlijn te bladeren</div>
      <div class="legend">
        <span data-leg="0">China</span>
        <span data-leg="0.5">Suriname</span>
        <span data-leg="1">Nederland</span>
      </div>
    </div>
  </div>
</section>

<style>
  .tocht {
    position: relative;
    background: var(--blue);
    color: #fff;
  }

  .pin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(24px, 4.5vh, 52px);
    padding-block: var(--section-y);
  }

  /* Pinned mode (enabled by the script). */
  .tocht.is-pinned {
    height: 560vh;
  }

  .tocht.is-pinned .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding-block: 72px 0;
  }

  .head {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .intro {
    max-width: 720px;
  }

  .tl-label {
    color: var(--on-blue-label);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.6vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin-top: 16px;
  }

  .year {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(56px, 8vw, 120px);
    line-height: 0.85;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .tocht:not(.is-pinned) .year {
    display: none;
  }

  .track-wrap {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .tocht.is-pinned .track-wrap {
    overflow: visible;
  }

  .track {
    list-style: none;
    margin: 0;
    display: flex;
    gap: clamp(14px, 1.6vw, 24px);
    width: max-content;
    padding: 0 var(--gutter);
    transform: var(--track-tf, none);
    will-change: transform;
  }

  .card {
    width: min(78vw, 380px);
    flex: none;
    min-height: min(42vh, 360px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    padding: clamp(22px, 2.2vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-snap-align: start;
    scroll-margin-inline: var(--gutter);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease;
  }

  /* The design used a 16% white tint here, which drops body text to 3.6:1.
     A lighter tint plus a brighter border keeps the active card obvious at ≥4.5:1. */
  .tocht.is-pinned .card.is-active {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.75);
  }

  .tocht.is-pinned .card.is-active p {
    color: #fff;
  }

  .place {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--on-blue-label);
  }

  .card-year {
    font-family: var(--font-serif);
    font-size: clamp(40px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;
  }

  .card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--on-blue-soft);
  }

  .controls {
    width: 100%;
  }

  .slider {
    position: relative;
    padding: 16px 0;
    margin: -16px 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .slider.is-dragging {
    cursor: grabbing;
  }

  .slider:focus-visible {
    outline-color: #fff;
  }

  .rail {
    position: relative;
    height: 2px;
    background: rgba(255, 255, 255, 0.3);
  }

  .fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background: #fff;
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
  }

  .knob {
    position: absolute;
    top: -6px;
    left: calc(var(--p, 0) * 100%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transform: translateX(-50%);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.18);
    transition:
      width 0.15s,
      height 0.15s,
      top 0.15s;
  }

  .slider.is-dragging .knob {
    width: 20px;
    height: 20px;
    top: -9px;
  }

  .hint {
    font-size: 12px;
    color: var(--on-blue-label);
    margin-top: 14px;
    transition: opacity 0.4s;
  }

  .hint.is-used {
    opacity: 0;
  }

  .legend {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* The design dimmed inactive labels to 50%, which fails contrast on blue.
     Labels stay legible; the nearest one is underlined instead. */
  .legend span {
    text-decoration: underline 2px transparent;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.3s;
  }

  .legend span.is-near {
    text-decoration-color: currentColor;
  }
</style>

<script>
  import { onScroll } from '@/scripts/scroll';
  import { clamp, prefersReducedMotion } from '@/scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-timeline]');

  if (section && !prefersReducedMotion()) {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...section.querySelectorAll<HTMLElement>('[data-card]')];
    const year = section.querySelector<HTMLElement>('[data-year]')!;
    const controls = section.querySelector<HTMLElement>('[data-controls]')!;
    const slider = section.querySelector<HTMLElement>('[data-slider]')!;
    const hint = section.querySelector<HTMLElement>('[data-hint]')!;
    const legend = [...section.querySelectorAll<HTMLElement>('[data-leg]')];
    const years = cards.map((c) => c.querySelector('.card-year')!.textContent!.trim());
    const steps = cards.length - 1;

    section.classList.add('is-pinned');
    controls.hidden = false;

    let shift = 0;
    let lastActive = -1;

    const measure = () => {
      shift = Math.max(0, track.scrollWidth - window.innerWidth);
    };

    /** Scroll progress through the pinned section, 0…1. */
    const progress = () => {
      const r = section.getBoundingClientRect();
      return clamp(-r.top / (r.height - window.innerHeight));
    };

    const render = () => {
      const p = progress();
      track.style.setProperty('--track-tf', `translateX(${(-p * shift).toFixed(1)}px)`);
      slider.style.setProperty('--p', p.toFixed(4));
      slider.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      const active = Math.round(p * steps);
      if (active !== lastActive) {
        lastActive = active;
        cards.forEach((c, i) => c.classList.toggle('is-active', i === active));
        year.textContent = years[active];
        slider.setAttribute('aria-valuetext', years[active]);
      }
      legend.forEach((l) => l.classList.toggle('is-near', Math.abs(p - Number(l.dataset.leg)) < 0.3));
    };

    /** Scroll the page so the timeline sits at fraction f. */
    const scrollToFraction = (f: number) => {
      const top = section.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + clamp(f) * (section.offsetHeight - window.innerHeight), behavior: 'instant' });
    };

    const markUsed = () => hint.classList.add('is-used');

    slider.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      slider.setPointerCapture(e.pointerId);
      slider.classList.add('is-dragging');
      markUsed();
      const seek = (x: number) => {
        const r = slider.getBoundingClientRect();
        scrollToFraction((x - r.left) / r.width);
      };
      seek(e.clientX);
      const move = (ev: PointerEvent) => seek(ev.clientX);
      const up = () => {
        slider.classList.remove('is-dragging');
        slider.removeEventListener('pointermove', move);
        slider.removeEventListener('pointerup', up);
        slider.removeEventListener('pointercancel', up);
      };
      slider.addEventListener('pointermove', move);
      slider.addEventListener('pointerup', up);
      slider.addEventListener('pointercancel', up);
    });

    slider.addEventListener('keydown', (e) => {
      const cur = Math.round(progress() * steps);
      const next =
        e.key === 'ArrowRight' || e.key === 'ArrowDown'
          ? Math.min(steps, cur + 1)
          : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
            ? Math.max(0, cur - 1)
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? steps
                : null;
      if (next === null) return;
      e.preventDefault();
      markUsed();
      scrollToFraction(next / steps);
    });

    measure();
    window.addEventListener('resize', measure, { passive: true });
    onScroll(render);
  }
</script>
